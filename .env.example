[TEMPLATE]
# ============================================================================
# KITANDA BACKEND - Environment Variables
# ============================================================================
# Copie este ficheiro para .env e preencha os valores.
# Em produção (Render) estas variáveis são definidas no dashboard — ver
# docs/DEPLOY-RENDER.md.

# --- Database (PostgreSQL / Neon) ---
# Preferencial em produção: uma única connection string (tem prioridade).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Fallback / desenvolvimento local
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here
DB_DATABASE=kitanda
# Forçar SSL (Neon exige). Default: ativo quando DB_HOST != localhost.
DB_SSL=false
# Ligações por instância (Neon free suporta ~100 no total)
DB_POOL_MAX=10

# --- JWT Authentication ---
# IMPORTANTE: obrigatório em produção, mínimo 32 caracteres.
# Exemplo: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_very_strong_random_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Login social NATIVO (Google — em produção já; Apple — deixar preparado) ---
GOOGLE_CLIENT_ID_WEB=seu_client_id_web.apps.googleusercontent.com
GOOGLE_CLIENT_ID_ANDROID=seu_client_id_android.apps.googleusercontent.com

# Apple (preencher quando a conta de programador pago estiver ativa)
APPLE_TEAM_ID=SEU_TEAM_ID
APPLE_CLIENT_ID=com.empresamega.kitanbacentral
APPLE_KEY_ID=SUA_KEY_ID
APPLE_PRIVATE_KEY_PATH=./config/AuthKey_XXXXXXXXXX.p8

# --- Redis Cache ---
# Em produção use REDIS_URL (Render Key Value). Tem prioridade sobre host/port.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=kitanda:

# --- Brevo Email (Transactional) ---
BREVO_API_KEY=xkeysib-your-api-key-here
BREVO_FROM=noreply@yourdomain.com
APP_NAME=Kitanda

# --- Cloudinary (File Uploads) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Cloudflare R2 (Presigned URL Uploads) ---
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_PUBLIC_DOMAIN=https://your-bucket.your-r2-domain.com

# --- App ---
NODE_ENV=development
# Render injeta PORT automaticamente; APP_PORT é usado só localmente.
APP_PORT=3000
APP_URL=http://localhost:3000
# CORS: lista separada por vírgulas (web, painel admin, etc.)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Swagger: desativado em produção salvo se estiver a "true"
ENABLE_SWAGGER=false
# Limite de payload JSON/form
BODY_LIMIT=2mb

# --- Rate Limiting (por IP) ---
THROTTLE_TTL=60
THROTTLE_LIMIT=300

# --- Brute Force Protection ---
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
